{{ if eq .chezmoi.os "darwin" -}}
font-size = 16
{{ else if eq .chezmoi.os "linux" -}}
font-size = 12
{{ end -}}
font-family = Berkeley Mono
font-family-bold = Berkeley Mono Bold
font-family-italic = Berkeley Mono Oblique
font-family-bold-italic = Berkeley Mono Bold Oblique

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

theme = Kanagawa Wave

mouse-hide-while-typing = true

{{ if eq .chezmoi.os "darwin" -}}
command = /opt/homebrew/bin/bash -l -c "tmux new-session -A -t main"
{{ else if eq .chezmoi.os "linux" -}}
command = /bin/bash -lc "tmux new-session -A -t main"
{{ end -}}

copy-on-select = clipboard
notify-on-command-finish = unfocused

clipboard-write = allow
clipboard-read = ask
