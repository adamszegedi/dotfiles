[git]
    autoCommit = true
    autoPush = true

[data]
    email   = {{ promptStringOnce . "email"   "Email address"   | quote }}
    signkey = {{ promptStringOnce . "signkey" "GPG signing key" | quote }}
    # Auto-detected: true only on Windows Subsystem for Linux
    isWSL   = {{ and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
